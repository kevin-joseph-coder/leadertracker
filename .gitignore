# Local database and its WAL sidecars
data/tracker.db
data/tracker.db-wal
data/tracker.db-shm

# Generated by the pipeline - regenerate with
# `python -m leadertracker.cohort` / `python -m leadertracker.poller`
data/cohort.json
web/positions.json
web/hourly.json
*.tmp

# Scheduled cohort refresh + poller output. The directory itself is tracked
# (via .gitkeep) so a fresh clone can redirect into it before the first run.
logs/*
!logs/.gitkeep

# Cross-process API mutex (apilock.py) - runtime state, never committed
.api.lock

__pycache__/
*.py[cod]
.venv/
venv/

# Editable install / build artifacts
*.egg-info/
build/
dist/
