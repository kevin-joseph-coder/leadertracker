<?xml version="1.0" encoding="UTF-16"?>
<!--
  Daily cohort refresh at 05:00 UTC - the quiet hours, chosen so the ~50
  minute run does not sit on top of a poll cycle during the active session.

  The Z suffix is written here for intent, but DO NOT rely on it to pin the
  run to UTC. Verified 2026-08-19: Task Scheduler converts the boundary to
  local time at registration and stores it that way - registering
  "2026-08-20T05:00:00Z" reads back as "2026-08-20T00:00:00-05:00", and
  Export-ScheduledTask confirms that is what is persisted. An earlier
  revision of this file claimed Z prevented DST drift; it does not.

  The practical consequence: the trigger fires at 00:00 America/Chicago year
  round, which is 05:00 UTC in CDT and 06:00 UTC in CST. An hour of seasonal
  drift is acceptable for a quiet-hours job - both times are well clear of
  the active session. If a fixed UTC instant ever matters, the schedule has
  to move into the script itself, not the trigger.

  Register with (replaces any existing definition - do not run while a
  refresh is in flight, it terminates the running instance):
    Register-ScheduledTask -TaskName "HL cohort refresh" -Force -Xml (Get-Content scheduled_task.xml -Raw)
-->
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>Refreshes the Hyperliquid BTC cohort (leaderboard shortlist + role/BTC enrichment) once a day at 00:00 UTC. Additive only - never retires wallets.</Description>
    <URI>\HL cohort refresh</URI>
  </RegistrationInfo>
  <Triggers>
    <CalendarTrigger>
      <StartBoundary>2026-08-20T05:00:00Z</StartBoundary>
      <Enabled>true</Enabled>
      <ScheduleByDay>
        <DaysInterval>1</DaysInterval>
      </ScheduleByDay>
    </CalendarTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <!-- The refresh is ~15-25 min of rate-limited API calls; a laptop on
         battery must not skip it. -->
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>true</RunOnlyIfNetworkAvailable>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>false</WakeToRun>
    <!-- Generous: the run is long by design, but must not hang forever. -->
    <ExecutionTimeLimit>PT2H</ExecutionTimeLimit>
    <Priority>7</Priority>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>C:\Windows\System32\cmd.exe</Command>
      <!--
        PYTHONPATH=src makes the package importable without an install step,
        so a fresh clone runs as-is.

        -u is not optional in a scheduled run: with stdout redirected to a
        file rather than a console, Python block-buffers it, and a 50 minute
        refresh writes NOTHING to the log until it exits. Unbuffered output
        makes progress visible while the job is still running.
      -->
      <Arguments>/c set PYTHONPATH=src &amp;&amp; C:\Python311\python.exe -u -m leadertracker.cohort &gt;&gt; logs\cohort.log 2&gt;&amp;1</Arguments>
      <WorkingDirectory>c:\Users\Kevin\Desktop\Projects\leadertracker</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
